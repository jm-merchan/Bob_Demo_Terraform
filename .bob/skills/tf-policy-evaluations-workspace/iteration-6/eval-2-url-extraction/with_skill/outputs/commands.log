$ RUN_ID=$(echo "https://app.terraform.io/app/hashi-demos-apj/workspaces/terraform-agentic-workflows-demo01/runs/run-iURWDL3wVxzefsjo" | grep -oE 'run-[A-Za-z0-9]+' | head -1)
$ echo "RUN_ID=$RUN_ID"
RUN_ID=run-iURWDL3wVxzefsjo

$ /Users/simon.lynch/go/bin/tfctl api /runs/$RUN_ID/task-stages -f 'include=policy-evaluations,run' --jq '{
  run: (.included[]? | select(.type=="runs") | .attributes | {status, trigger: ."trigger-reason"}),
  stages: [.data[] | {id, stage: .attributes.stage, status: .attributes.status,
    pe_ids: [.relationships."policy-evaluations".data[]?.id]}],
  evaluations: [.included[]? | select(.type=="policy-evaluations") | .attributes as $a | {
    id: .id, kind: $a."policy-kind", status: $a.status, counts: $a."result-count"}]
}'
