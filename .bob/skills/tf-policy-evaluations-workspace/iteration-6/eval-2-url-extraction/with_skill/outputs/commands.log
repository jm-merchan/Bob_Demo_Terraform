$ /Users/simon.lynch/go/bin/tfctl api /policy-evaluations/poleval-qvaFSNdUdasiLqfU/policy-set-outcomes --jq '.data[] | .attributes as $a | {
  policy_set: $a."policy-set-name",
  tool_version: $a."policy-tool-version",
  overridable: $a.overridable,
  error: $a.error,
  counts: $a."result-count",
